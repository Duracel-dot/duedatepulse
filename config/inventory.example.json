                    { "id": "core-2", "type": "switch",   "name": "CORE-2", "u": 37, "height": 1, "hostname": "core-2", "ip": "10.0.0.2",   "vendor": "Aruba",    "model": "CX 6300M" },
                    { "id": "nas-1",  "type": "storage",  "name": "NAS-1",  "u": 10, "height": 2, "hostname": "nas-1",  "ip": "10.0.0.30",  "vendor": "Synology", "model": "RS3621xs+" }
                  ]
                },
                {
                  "id": "A02", "units": 42,
                  "devices": [
                    { "id": "hv01", "type": "server", "name": "HV01", "u": 20, "height": 2, "hostname": "HV01", "serial": "CZJ1234567", "vendor": "HPE", "model": "ProLiant DL380 Gen10" },
                    { "id": "hv02", "type": "server", "name": "HV02", "u": 17, "height": 2, "hostname": "HV02", "serial": "CZJ7654321", "vendor": "HPE", "model": "ProLiant DL380 Gen10" },
                    { "id": "srv-backup", "type": "server", "name": "SRV-BACKUP", "u": 5, "height": 2, "hostname": "srv-backup", "vendor": "Dell", "model": "PowerEdge R740xd" },
