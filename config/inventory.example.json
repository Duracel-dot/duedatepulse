          "rows": [
            {
              "name": "A", "rotation": 0,        // 0 : facades vers +Z ; 180 : facades vers -Z (allee froide partagee)
              "racks": [
                {
                  "id": "A01", "units": 42,
                  "devices": [
                    // u = position basse (1 = bas de baie), height = hauteur en U
                    { "id": "fw-1",   "type": "firewall", "name": "FW-1",   "u": 40, "height": 1, "hostname": "fw-1",   "ip": "10.0.0.254", "vendor": "Fortinet", "model": "FortiGate 200F" },
